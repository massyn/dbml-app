# Required unless given on the command line (--dbml / --db take precedence)
DBML=test.dbml
DB=test.db

# Optional
HOST=127.0.0.1
PORT=5000
PAGE_SIZE=25
FLASK_DEBUG=0
# SECRET_KEY=  # signs flash messages and CSRF tokens; a random per-process key is used if unset
#               (open forms then stop working after a restart)
